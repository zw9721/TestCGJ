# This .gitignore file should be placed at the root of your Unity project folder.
#
# Typically it will be /UnityProject/.gitignore
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Ss]napshotCaptures/

# Autogenerated VS/MD/Consulo solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash
sysinfo.txt

# Autogenerated asset meta file folder
.vs/
.idea/
.DS_Store
.vscode/
.plastic/

# Visual Studio Code files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Gradle files
.gradle/
build/

# Mac
.DS_Store
# Windows
Thumbs.db
Desktop.ini

# Rider
.idea/
*.csproj.DotSettings
*.sln.DotSettings

# Local history files
.localhistory/

# Packages
/Packages/
/Assets/Packages/

# Crashlytics
crashlytics-build.properties

# Yarn lockfile
yarn.lock
ignore.conf